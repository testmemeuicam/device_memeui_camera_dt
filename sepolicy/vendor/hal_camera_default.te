binder_call(hal_camera_default, platform_app)
allow hal_camera_default hal_misys_vendor_exec:file entrypoint;
allow hal_camera_default hal_misys_vendor_service:service_manager add;
allow hal_camera_default vendor_camera_data_file:dir { create_dir_perms r_dir_perms };
allow hal_camera_default vendor_camera_data_file:file { create_file_perms rw_file_perms };
allow hal_camera_default appdomain_tmpfs:file rw_file_perms;
